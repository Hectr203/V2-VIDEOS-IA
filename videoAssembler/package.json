{
  "name": "videassembler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-core": "mkdir -p public/ffmpeg && cp node_modules/@ffmpeg/core-mt/dist/esm/ffmpeg-core.js node_modules/@ffmpeg/core-mt/dist/esm/ffmpeg-core.wasm node_modules/@ffmpeg/core-mt/dist/esm/ffmpeg-core.worker.js public/ffmpeg/",
    "predev": "npm run sync-core",
    "dev": "vite",
    "prebuild": "npm run sync-core",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "render": "node cli/render.ts"
  },
  "dependencies": {
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
