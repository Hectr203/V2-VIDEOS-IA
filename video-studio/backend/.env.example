# Configuración Centralizada de Inteligencia Artificial (OmniRoute en Azure)
OMNIROUTE_BASE_URL=https://omniroute-api.azurewebsites.net
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini

# SQLite local por defecto: video_studio.sqlite3 en la raíz de video-studio.
# Descomenta para elegir otra ruta absoluta.
# VIDEO_STUDIO_DB_PATH=/ruta/segura/video_studio.sqlite3
# Concurrencia de Remotion; bajar el porcentaje si el render satura RAM/CPU.
VIDEO_STUDIO_RENDER_CONCURRENCY=25%

# Proveedores de Voz Opcionales (Modular Voice Hub)
ELEVENLABS_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# VibeVoice todavía no tiene adaptador de inferencia integrado.
