# ==============================================================================
# V2-VIDEOS-IA · Plantilla de Configuración del Backend (.env.example)
# ==============================================================================
# Instrucciones para nuevos usuarios:
#   1. Copia este archivo como `.env` dentro de `video-studio/backend/`:
#        cp video-studio/backend/.env.example video-studio/backend/.env
#   2. Completa únicamente las credenciales de los servicios que vayas a utilizar.
#   3. NUNCA subas tu archivo `.env` real a Git (está protegido por `.gitignore`).
# ==============================================================================

# ── 1. Inteligencia Artificial para guiones / storyboards (OmniRoute / OpenAI compatible)
OMNIROUTE_BASE_URL=https://omniroute-api.azurewebsites.net
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini

# ── 2. Persistencia local y rendimiento de Remotion
# SQLite local por defecto: video_studio.sqlite3 en la raíz de video-studio.
# Descomenta para elegir otra ruta absoluta:
# VIDEO_STUDIO_DB_PATH=/ruta/segura/video_studio.sqlite3
# Porcentaje de CPU/RAM para Remotion (baja a 25% o 1 si tu equipo tiene poca RAM):
VIDEO_STUDIO_RENDER_CONCURRENCY=25%

# ── 3. Gateway Multi-Cuenta de ElevenLabs (Rotación Automática por Créditos) ──
# Arquitectura recomendada: variables indexadas `ELEVENLABS_API_KEY_1..6` en `.env`.
# El gateway verifica la salud de ElevenLabs y los caracteres restantes de cada cuenta
# (`/v1/user/subscription`). Cuando una cuenta baja del umbral seguro o agota cuota,
# rota automáticamente a la siguiente sin interrumpir la generación del video.
#
# Opción A (Recomendada para 2 a 6+ cuentas; puedes comentar una línea para pausarla):
ELEVENLABS_API_KEY_1=
ELEVENLABS_API_KEY_2=
ELEVENLABS_API_KEY_3=
ELEVENLABS_API_KEY_4=
ELEVENLABS_API_KEY_5=
ELEVENLABS_API_KEY_6=

# Opción B (Alternativa compacta separada por comas; se combina sin duplicados):
# ELEVENLABS_API_KEYS=sk_cuenta1,sk_cuenta2,sk_cuenta3

# Opción C (Retrocompatibilidad para usuarios con una sola cuenta):
# ELEVENLABS_API_KEY=

# Umbral mínimo seguro de caracteres antes de rotar a la siguiente cuenta (default: 500):
ELEVENLABS_MIN_CREDITS_THRESHOLD=500

# Modelo por defecto de ElevenLabs:
#   - eleven_flash_v2_5        (Ahorro máximo de cuota y baja latencia · recomendado)
#   - eleven_turbo_v2_5        (Equilibrio calidad/velocidad)
#   - eleven_multilingual_v2   (Máxima expresividad actoral y dramática)
ELEVENLABS_DEFAULT_MODEL=eleven_flash_v2_5

# Timeout HTTP en segundos para peticiones a ElevenLabs (default: 30):
ELEVENLABS_REQUEST_TIMEOUT=30

# ── 4. Otros proveedores de voz opcionales ────────────────────────────────────
# Edge-TTS funciona gratis sin configuración adicional.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
# Ruta local opcional de Applio (RVC v2) si utilizas clonación de voz local:
# VIBEVOICE_DIR=
